{
  "name": "edgewise",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-tasks.mjs && vite",
    "build": "node scripts/build-tasks.mjs && vite build",
    "preview": "vite preview",
    "build:tasks": "node scripts/build-tasks.mjs",
    "test": "node --test tests/*.test.mjs && node scripts/run-e2e-tests.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:e2e": "node scripts/run-e2e-tests.mjs",
    "autoloop": "node scripts/autoloop/edgewise-autoloop-runner.mjs",
    "autoloop:check": "node scripts/autoloop/edgewise-autoloop-runner.mjs --check",
    "autoloop:qa": "node scripts/autoloop/qa-watchdog.mjs",
    "autoloop:sync": "node scripts/autoloop/neat-freak-sync.mjs",
    "autoloop:empirical": "PYTHONPATH=backend python3 scripts/autoloop/empirical-monitor.py",
    "autoloop:ugc": "PYTHONPATH=backend python3 scripts/autoloop/ugc-reviewer.py"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@mediapipe/tasks-vision": "^1.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@react-three/fiber": "^9.5.0",
    "axios": "^1.21.0",
    "html-to-image": "^1.11.13",
    "monaco-editor": "^0.57.0",
    "page-agent": "^1.5.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0",
    "three": "^0.183.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^2.0.0"
  }
}
