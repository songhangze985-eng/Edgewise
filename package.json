{
  "name": "edgewise",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-tasks.mjs && vite",
    "build": "node scripts/build-tasks.mjs && vite build",
    "preview": "vite preview",
    "build:tasks": "node scripts/build-tasks.mjs",
    "test": "node --test tests/*.test.mjs src/features/interview/*.test.js && node scripts/run-e2e-tests.mjs",
    "test:unit": "node --test tests/*.test.mjs src/features/interview/*.test.js",
    "test:backend": "PY_BIN=$( [ -x backend/.venv/bin/python ] && echo backend/.venv/bin/python || echo python3 ); PYTHONPATH=backend $PY_BIN -m unittest discover -s backend/tests",
    "test:e2e": "node scripts/run-e2e-tests.mjs",
    "test:all": "npm run test:unit && npm run test:backend && npm run test:e2e",
    "seed:dataset": "python3 backend/scripts/etl_chinese_interview_dataset.py",
    "seed:pdf": "python3 backend/scripts/generate_pdf_seed.py --check",
    "autoloop": "node scripts/autoloop/edgewise-autoloop-runner.mjs",
    "autoloop:check": "node scripts/autoloop/edgewise-autoloop-runner.mjs --check",
    "autoloop:qa": "node scripts/autoloop/qa-watchdog.mjs",
    "autoloop:sync": "node scripts/autoloop/neat-freak-sync.mjs",
    "autoloop:empirical": "PYTHONPATH=backend python3 scripts/autoloop/empirical-monitor.py",
    "autoloop:ugc": "PYTHONPATH=backend python3 scripts/autoloop/ugc-reviewer.py",
    "autoloop:derive": "PYTHONPATH=backend python3 scripts/autoloop/daily-derive-scheduler.py",
    "autoloop:blind": "PYTHONPATH=backend python3 scripts/autoloop/blind-review-dispatcher.py",
    "autoloop:paper": "PYTHONPATH=backend python3 scripts/autoloop/paper-sync-verifier.py",
    "autoloop:dataset": "PYTHONPATH=backend python3 scripts/autoloop/dataset-etl-watcher.py",
    "autoloop:scripted": "PYTHONPATH=backend python3 scripts/autoloop/scripted-answer-auditor.py"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@mediapipe/tasks-vision": "^1.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@react-three/fiber": "^9.5.0",
    "axios": "^1.21.0",
    "html-to-image": "^1.11.13",
    "monaco-editor": "^0.57.0",
    "page-agent": "^1.5.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.8.0",
    "three": "^0.183.2",
    "zustand": "^5.0.11"
  },
  "overrides": {
    "react-router": "^7.18.5",
    "react-router-dom": "^7.18.5",
    "dompurify": "^3.4.17",
    "zod": "^4.6.7",
    "nanoid": "^3.3.20",
    "lodash-es": "^4.18.1",
    "katex": "^0.19.1",
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "^5.1.16"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^2.0.0"
  }
}
