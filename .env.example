# Frontend (optional — default uses Vite proxy /api/v1)
# VITE_API_BASE=/api/v1

# Backend — place as backend/.env
APP_ENV=development
REDIS_URL=redis://localhost:6379/0
# REQUIRED in production: replace with a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Optional: dedicated HMAC key for research export hashes (falls back to JWT_SECRET)
# RESEARCH_HASH_SECRET=
